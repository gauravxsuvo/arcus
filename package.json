{
  "name": "training-operating-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "node scripts/run-portways-app.mjs dev",
    "build": "next build",
    "start": "node scripts/run-portways-app.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "db:check": "node scripts/check-db.mjs",
    "db:init": "node scripts/init-portways-db.mjs",
    "db:migrate:admin": "node scripts/migrate-admin-management.mjs",
    "db:migrate:flags": "node scripts/migrate-admin-feature-flags.mjs",
    "db:migrate:approved-admin": "node scripts/migrate-approved-admin-access.mjs",
    "db:migrate:admin-rbac": "node scripts/migrate-admin-rbac.mjs",
    "db:migrate:pro-social": "node scripts/migrate-pro-social.mjs",
    "db:migrate:social-production": "node scripts/migrate-social-production.mjs",
    "db:migrate:avatar-storage": "node scripts/migrate-avatar-storage.mjs",
    "storage:check": "node scripts/check-avatar-storage.mjs",
    "db:migrate:passkeys": "node scripts/migrate-passkeys.mjs",
    "db:migrate:routines": "node scripts/migrate-routines.mjs",
    "db:migrate:mfa": "node scripts/migrate-mfa.mjs",
    "db:migrate:sleep": "node scripts/migrate-sleep-readiness.mjs",
    "db:migrate:weight": "node scripts/migrate-weight-logs.mjs",
    "db:migrate:workout-performance": "node scripts/migrate-workout-performance.mjs",
    "admin:configure": "node scripts/configure-admin.mjs",
    "db:bridge": "node scripts/portways-db-bridge.mjs --gateway wss://db.portways.app/v1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@google/genai": "^2.28.0",
    "@neondatabase/serverless": "^1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vercel/analytics": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^14.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "next": "^15.5.3",
    "next-themes": "^0.4.6",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
