NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PORTWAYS_DB_TOKEN=
PGUSER=remote_5
PGPASSWORD=
PGDATABASE=arcus_postgres

# Private Portways S3-compatible profile photo storage. Keep these server-only.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=arcus-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Owner console: both must match the same existing account. Never use NEXT_PUBLIC_ keys.
# Run npm run admin:configure -- owner@example.com to pin the local account.
ARCUS_ADMIN_EMAIL=
ARCUS_ADMIN_ACCOUNT_ID=

# Public website origin for sharing previews. Set this to your actual deployed URL.
# Vercel deployments also use VERCEL_PROJECT_PRODUCTION_URL automatically.
# Local development falls back to http://localhost:3000.
SITE_URL=

# Optional explicit WebAuthn identity. In production, SITE_URL or Vercel's
# production URL is used automatically; local development accepts localhost.
WEBAUTHN_ORIGIN=
WEBAUTHN_RP_ID=

# Public legal contact and governing law for the privacy and terms pages.
PUBLIC_CONTACT_EMAIL=buildarcus@gmail.com
LEGAL_GOVERNING_LAW=India
